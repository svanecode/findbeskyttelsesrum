# Public Supabase read access. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase access. Leave blank unless a local script needs it.
# Never rename this to a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=

# Datafordeler importer. SUPABASE_URL is the same project URL as above.
DATAFORDELER_API_KEY=
SUPABASE_URL=https://your-project.supabase.co

# Optional local overrides for production smoke monitoring.
# SMOKE_BASE_URL=https://findbeskyttelsesrum.dk
# SMOKE_MAX_IMPORT_AGE_HOURS=72
# SMOKE_REQUEST_TIMEOUT_MS=15000
# SMOKE_EXPECTED_GIT_SHA=

# Optional health thresholds. Production is degraded when either limit fails.
# HEALTH_MAX_DATA_AGE_HOURS=48
# HEALTH_MIN_PUBLIC_REGISTRATIONS=500
