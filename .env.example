# Public Supabase read access. These values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public token for Klimadatastyrelsen's Adressevælger. Not a secret; the shared
# token below is the one Klimadatastyrelsen asks all clients to use for now.
NEXT_PUBLIC_ADRESSEVAELGER_TOKEN=adressevaelger123

# Server-only Supabase access. Leave blank unless a local script needs it.
# Never rename this to a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=

# Dedicated server-only HMAC secret for anonymous distributed rate limits.
# Generate at least 32 random characters; never expose it with NEXT_PUBLIC_*.
RATE_LIMIT_HASH_SECRET=

# Public privacy-notice identity. Contact is handled by the private portal.
PRIVACY_CONTROLLER_NAME=Andreas Svane
# Optional postal or official contact address shown on the privacy page.
PRIVACY_CONTROLLER_ADDRESS=

# Datafordeler importer. SUPABASE_URL is the same project URL as above.
DATAFORDELER_API_KEY=
SUPABASE_URL=https://your-project.supabase.co

# Optional local overrides for production smoke monitoring.
# SMOKE_BASE_URL=https://findbeskyttelsesrum.dk
# SMOKE_MAX_IMPORT_AGE_HOURS=72
# SMOKE_REQUEST_TIMEOUT_MS=15000
# SMOKE_EXPECTED_GIT_SHA=
# Retries of transient failures per check (positive integers; defaults shown).
# SMOKE_TRANSIENT_RETRY_ATTEMPTS=6
# SMOKE_TRANSIENT_RETRY_DELAY_MS=5000

# Optional health thresholds. Production is degraded when either limit fails.
# HEALTH_MAX_DATA_AGE_HOURS=48
# HEALTH_MIN_PUBLIC_REGISTRATIONS=500
# HEALTH_MAX_OPERATION_AGE_MINUTES=480
# HEALTH_MAX_OPERATION_HARD_AGE_MINUTES=1440

# Anonymous product-metrics check (scripts/monitor/product-metrics-health.mjs).
# Fails when more than the maximum number of client errors was counted within
# the window. The window is a whole number of hours between 1 and 24.
# METRICS_HEALTH_WINDOW_HOURS=2
# METRICS_HEALTH_MAX_ERRORS=25

# Emergency load-shedding switch for the web app: set to 1 and redeploy to stop
# all product-metric database writes while the search keeps working.
# PRODUCT_METRICS_DISABLED=1
