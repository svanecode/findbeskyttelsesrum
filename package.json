{
  "name": "beskyttelsesrum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:db": "supabase test db supabase/tests --local",
    "test:e2e": "PLAYWRIGHT_HTTP_ORIGIN=1 npm run build && playwright test",
    "test:e2e:ui": "playwright test -c playwright.ui.config.ts",
    "test:e2e:headed": "PLAYWRIGHT_HTTP_ORIGIN=1 npm run build && playwright test --headed",
    "test:a11y": "PLAYWRIGHT_HTTP_ORIGIN=1 npm run build && playwright test e2e/accessibility.spec.ts",
    "test:release": "npm run lint && npm run typecheck && npm test && npm run parity:exclusions && npm run parity:municipalities && PLAYWRIGHT_HTTP_ORIGIN=1 npm run build && playwright test",
    "typecheck": "tsc --noEmit",
    "verify-assets": "node scripts/verify-hashed-assets.js",
    "parity:municipalities": "tsx scripts/parity/municipalities.ts",
    "parity:exclusions": "tsx scripts/parity/exclusions.ts",
    "parity:nearby-tiles": "tsx scripts/parity/nearby-tiles.ts",
    "export:application-codes": "tsx scripts/export/application-code-eligibility.ts",
    "read:shelter-detail": "node --conditions=react-server --import tsx scripts/read/app-v2-shelter-detail.ts",
    "read:app-v2-sanity": "node --conditions=react-server --import tsx scripts/read/app-v2-sanity.ts",
    "read:app-v2-nearby-api": "tsx scripts/read/app-v2-nearby-api.ts",
    "monitor:production": "node scripts/monitor/production-smoke.mjs"
  },
  "dependencies": {
    "@react-leaflet/core": "^3.0.0",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "next": "^16.4.2",
    "proj4": "^2.20.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.62.1",
    "@types/leaflet": "^1.9.20",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "8.5.30",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.30"
    }
  }
}
